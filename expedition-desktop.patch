+        def draw_route(event):
+            route.delete("all")
+            points = [(40 + (event.width - 80) * (i if i < 5 else 9 - i) / 4,
+                       48 if i < 5 else 125) for i in range(10)]
+            for index, (start, end) in enumerate(zip(points, points[1:])):
+                route.create_line(*start, *end, width=5,
+                                  fill=GREEN if index < revealed else "#a8bfb4")
+            for index, (x, y) in enumerate(points):
+                color = GREEN if index < revealed else "#a8bfb4"
+                if index == revealed:
