@@ -68,6 +68,41 @@ class DesktopTest(unittest.TestCase):
             self.assertTrue(generate("每天阅读", "", CONDITIONS, [], [])["steps"])
             request.assert_not_called()
 
+    def test_expedition_rewards_once_and_preserves_artifacts(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path = Path(folder) / "quest.db"
+            store = Store(path)
+            draft = generate("每天阅读", "", CONDITIONS, [], [])
+            for index in range(2):
+                quest = store.create_quest("每天阅读", "", CONDITIONS, draft)
+                self.assertTrue(store.transition(quest, "PENDING", "ACTIVE"))
+                self.assertTrue(store.transition(quest, "ACTIVE", "COMPLETED", f"记下第 {index + 1} 条笔记"))
+                self.assertFalse(store.transition(quest, "ACTIVE", "COMPLETED", "重复提交"))
+            self.assertEqual(Store(path).expedition("每天阅读")["completed_actions"], 2)
+            self.assertEqual(store.expedition("每天阅读")["supplies"], 2)
+            self.assertEqual(len(store.artifacts("每天阅读")), 2)
+            self.assertIn("第 2 条", store.artifacts("每天阅读")[0]["content"])
+            self.assertTrue(store.build("每天阅读", "campfire"))
+            self.assertFalse(store.build("每天阅读", "campfire"))
+            self.assertEqual(Store(path).expedition("每天阅读")["campfire_level"], 1)
+            self.assertEqual(Store(path).expedition("每天阅读")["supplies"], 0)
+            self.assertEqual(Store(path).expedition("跑步")["completed_actions"], 0)
+
+    def test_old_completed_quest_backfills_expedition(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path = Path(folder) / "quest.db"
+            store = Store(path)
+            quest = store.create_quest("跑步", "", CONDITIONS, generate("跑步", "", CONDITIONS, [], []))
+            store.transition(quest, "PENDING", "ACTIVE")
+            store.transition(quest, "ACTIVE", "COMPLETED", "慢跑五分钟")
+            with store.connect() as db:
+                db.execute("DROP TABLE artifact")
+                db.execute("DROP TABLE expedition")
+            reopened = Store(path)
+            self.assertEqual(reopened.expedition("跑步")["completed_actions"], 1)
+            self.assertEqual(reopened.artifacts("跑步")[0]["content"], "慢跑五分钟")
+            self.assertEqual(Store(path).expedition("跑步")["completed_actions"], 1)
+
 
 if __name__ == "__main__":
     unittest.main()
