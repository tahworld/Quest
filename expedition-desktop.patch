@@ -89,14 +109,50 @@ class Store:
 
     def transition(self, quest_id, old_status, new_status, result=None):
         with self.connect() as db:
+            existing = db.execute("SELECT direction,draft FROM quest WHERE id=?", (quest_id,)).fetchone()
             cursor = db.execute(
                 "UPDATE quest SET status=?, result_text=?, completed_at=? "
                 "WHERE id=? AND status=?",
                 (new_status, result, int(time.time()) if new_status == "COMPLETED" else None,
                  quest_id, old_status),
             )
+            if cursor.rowcount == 1 and new_status == "COMPLETED" and existing:
+                direction, draft = existing
+                db.execute("INSERT INTO expedition(direction,completed_actions,supplies) VALUES(?,1,1) "
+                           "ON CONFLICT(direction) DO UPDATE SET completed_actions=completed_actions+1,supplies=supplies+1",
+                           (direction,))
+                db.execute("INSERT INTO artifact(quest_id,direction,title,content,created_at) VALUES(?,?,?,?,?)",
+                           (quest_id, direction, json.loads(draft)["title"], result or "", int(time.time())))
             return cursor.rowcount == 1
 
+    def expedition(self, direction):
+        with self.connect() as db:
+            db.row_factory = sqlite3.Row
+            row = db.execute("SELECT * FROM expedition WHERE direction=?", (direction,)).fetchone()
+        return dict(row) if row else dict(direction=direction, completed_actions=0, supplies=0,
+                                          campfire_level=0, shelter_level=0, lookout_level=0)
+
+    def build(self, direction, building):
+        if building not in ("campfire", "shelter", "lookout"):
+            raise ValueError("未知营地建筑")
+        column = building + "_level"
+        with self.connect() as db:
+            db.execute("INSERT OR IGNORE INTO expedition(direction) VALUES(?)", (direction,))
+            row = db.execute(f"SELECT {column} FROM expedition WHERE direction=?", (direction,)).fetchone()
+            if row[0] >= 3:
+                return False
+            cost = row[0] + 2
+            changed = db.execute(f"UPDATE expedition SET supplies=supplies-?, {column}={column}+1 "
+                                 "WHERE direction=? AND supplies>=?", (cost, direction, cost))
+            return changed.rowcount == 1
+
+    def artifacts(self, direction, limit=30):
+        with self.connect() as db:
+            db.row_factory = sqlite3.Row
+            rows = db.execute("SELECT title,content,created_at FROM artifact WHERE direction=? "
+                              "ORDER BY created_at DESC,quest_id DESC LIMIT ?", (direction, limit)).fetchall()
+        return [dict(row) for row in rows]
+
