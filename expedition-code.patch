+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                Text("我的营地", style = MaterialTheme.typography.titleLarge)
+                Text("物资 ${progress.supplies}", style = MaterialTheme.typography.titleMedium, color = MaterialTheme.colorScheme.primary)
