@@ -0,0 +1,35 @@
+package com.vika.quest.ai
+
+class AiContinueValidator(private val questValidator: AiQuestDraftValidator) {
+    fun validate(reply: AiFollowUp, context: QuestContinueContext): AiFollowUp = when (reply) {
+        is AiFollowUp.Question -> {
+            require(context.advice == null) { "建议已明确当前动作，须生成下一步" }
+            require(context.questionCount < 3) { "已到三次追问上限，必须给出下一步" }
+            val question = reply.question.trim()
+            require(question.length in 8..180) { "追问不能为空或过长" }
+            require(question.count { it == '?' || it == '？' } <= 1 && !Regex("(?m)^\\s*[1-9][.、)]").containsMatchIn(question)) { "每轮只能问一个问题" }
+            require(reply.reasoningType.isNotBlank()) { "缺少追问依据" }
+            reply.copy(question = question)
+        }
+        is AiFollowUp.NextAction -> {
+            require(reply.draft.estimatedMinutes in 5..30) { "下一步应在 5 到 30 分钟内" }
+            questValidator.validate(reply.draft, generationContext(context))
+            reply
+        }
+    }
+
+    fun validateAdvice(advice: AiAdvice): AiAdvice {
+        require(advice.core.isNotBlank() && advice.action.isNotBlank() && advice.later.isNotBlank()) { "建议内容不完整" }
+        require(advice.core.length + advice.action.length + advice.later.length <= 250) { "建议过长" }
+        return advice.copy(core = advice.core.trim(), action = advice.action.trim(), later = advice.later.trim())
+    }
+
+    fun generationContext(context: QuestContinueContext): QuestGenerationContext {
+        val parent = context.quest
+        val intention = listOf(parent.sourceIntention, context.resultText, context.history.joinToString("；") { it.answer }, context.advice?.action.orEmpty()).filter(String::isNotBlank).joinToString("。 ").take(2_000)
+        return parent.generationContext().copy(
+            userIntention = intention,
+            recentQuests = (listOf(parent.quest.copy(resultSummary = context.resultText.take(500))) + context.chain).distinctBy { it.id }.take(4),
+        )
+    }
+}
