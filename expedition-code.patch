@@ -0,0 +1,88 @@
+package com.vika.quest.data.repository
+
+import androidx.room.withTransaction
+import com.vika.quest.data.local.QuestDatabase
+import com.vika.quest.data.local.entity.AdviceResultEntity
+import com.vika.quest.data.local.entity.ContinueSessionEntity
+import com.vika.quest.data.local.entity.ContinueTurnEntity
+import com.vika.quest.data.local.entity.QuestEntity
+import com.vika.quest.model.NewQuest
+import com.vika.quest.model.QuestStatus
+import java.util.UUID
+
+/** Stable continuation records live in Room. Transient network states live in the ViewModel. */
+class ContinueRepository(private val db: QuestDatabase, private val quests: QuestRepository) {
+    private val dao = db.continueDao()
+
+    suspend fun session(questId: String) = dao.session(questId)
+    suspend fun turns(sessionId: String) = dao.turns(sessionId)
+    suspend fun advice(questId: String) = dao.advice(questId)
+    suspend fun child(questId: String) = quests.getChild(questId)
+
+    suspend fun begin(questId: String): ContinueSessionEntity = db.withTransaction {
+        val quest = checkNotNull(db.questDao().getById(questId)) { "行动不存在" }
+        check(quest.status == QuestStatus.COMPLETED) { "行动完成后才能继续推进" }
+        dao.session(questId)?.let { existing ->
+            if (existing.status == "PAUSED") dao.updateSession(existing.copy(status = "IDLE", updatedAt = System.currentTimeMillis()))
+            return@withTransaction dao.session(questId)!!
+        }
+        val now = System.currentTimeMillis()
+        val value = ContinueSessionEntity(UUID.randomUUID().toString(), questId, "IDLE", 0, now, now)
+        dao.insertSession(value)
+        dao.session(questId)!!
+    }
+
+    suspend fun saveQuestion(questId: String, question: String, reasoningType: String?): ContinueTurnEntity = db.withTransaction {
+        val session = checkNotNull(dao.session(questId))
+        val turns = dao.turns(session.id)
+        turns.lastOrNull()?.takeIf { it.answer == null }?.let { return@withTransaction it }
+        check(session.status != "PAUSED" && session.questionCount < MAX_QUESTIONS) { "追问已结束" }
+        val now = System.currentTimeMillis()
+        val turn = ContinueTurnEntity(UUID.randomUUID().toString(), session.id, session.questionCount, "QUESTION", question, null, reasoningType, now)
+        dao.insertTurn(turn)
+        dao.updateSession(session.copy(status = "ASKING", questionCount = session.questionCount + 1, updatedAt = now))
+        turn
+    }
+
+    suspend fun answer(questId: String, text: String) = db.withTransaction {
+        val session = checkNotNull(dao.session(questId))
+        check(session.status == "ASKING") { "当前没有待回答的问题" }
+        val turn = checkNotNull(dao.turns(session.id).lastOrNull())
+        check(turn.answer == null) { "回答已经提交" }
+        require(text.isNotBlank()) { "请写下你的回答" }
+        dao.updateTurn(turn.copy(answer = text.trim().take(1_000)))
+        dao.updateSession(session.copy(status = "IDLE", updatedAt = System.currentTimeMillis()))
+    }
+
+    suspend fun pause(questId: String) = db.withTransaction {
+        val session = dao.session(questId) ?: run {
+            val quest = checkNotNull(db.questDao().getById(questId))
+            check(quest.status == QuestStatus.COMPLETED)
+            val now = System.currentTimeMillis()
+            dao.insertSession(ContinueSessionEntity(UUID.randomUUID().toString(), questId, "PAUSED", 0, now, now))
+            return@withTransaction
+        }
+        dao.updateSession(session.copy(status = "PAUSED", updatedAt = System.currentTimeMillis()))
+    }
+
+    suspend fun saveAdvice(questId: String, core: String, action: String, later: String): AdviceResultEntity = db.withTransaction {
+        dao.advice(questId)?.let { return@withTransaction it }
+        check(dao.session(questId)?.status != "PAUSED") { "推进已暂停" }
+        val quest = checkNotNull(db.questDao().getById(questId))
+        check(quest.status == QuestStatus.COMPLETED)
+        dao.insertAdvice(AdviceResultEntity(UUID.randomUUID().toString(), questId, core, action, later, System.currentTimeMillis()))
+        dao.advice(questId)!!
+    }
+
+    suspend fun saveChild(parentId: String, next: NewQuest): QuestEntity = db.withTransaction {
+        quests.getChild(parentId)?.let { return@withTransaction it }
+        val parent = checkNotNull(db.questDao().getById(parentId))
+        check(parent.status == QuestStatus.COMPLETED) { "原行动尚未完成" }
+        check(dao.session(parentId)?.status != "PAUSED") { "推进已暂停" }
+        val child = quests.createQuest(next.copy(parentQuestId = parentId))
+        dao.session(parentId)?.let { dao.updateSession(it.copy(status = "NEXT_QUEST_READY", updatedAt = System.currentTimeMillis())) }
+        child
+    }
+
+    companion object { const val MAX_QUESTIONS = 3 }
+}
