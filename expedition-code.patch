+package com.vika.quest.model
+
+import com.vika.quest.data.local.entity.ExpeditionEntity
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Test
+
+class ExpeditionRulesTest {
+    @Test fun mapKeepsProgressAcrossChapters() {
+        assertEquals(1, ExpeditionRules.chapter(9))
+        assertEquals(2, ExpeditionRules.chapter(10))
+        assertEquals(0, ExpeditionRules.exploredInChapter(10))
+    }
+
+    @Test fun playerChoosesOneBuildingAndSpendsSupplies() {
+        val state = ExpeditionEntity("goal", completedActions = 4, supplies = 4)
+        val built = ExpeditionRules.build(state, CampBuilding.LOOKOUT)
+        assertEquals(2, built.supplies)
+        assertEquals(1, built.lookoutLevel)
+        assertEquals(0, built.shelterLevel)
+        assertEquals(4, built.completedActions)
+        assertThrows(IllegalArgumentException::class.java) { ExpeditionRules.build(built.copy(supplies = 0), CampBuilding.SHELTER) }
+    }
+}
