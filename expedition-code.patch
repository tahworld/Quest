+package com.vika.quest.data.repository
+
+import androidx.room.Room
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.vika.quest.data.local.QuestDatabase
+import com.vika.quest.model.CampBuilding
+import com.vika.quest.model.NewQuest
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@RunWith(AndroidJUnit4::class)
+class ExpeditionPersistenceTest {
+    @Test fun completionRewardsOnceAndStoresArtifact() = runBlocking {
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        val db = Room.inMemoryDatabaseBuilder(context, QuestDatabase::class.java).allowMainThreadQueries().build()
+        try {
+            val goal = GoalRepository(db.goalDao()).createGoal("建设自己的 App", "继续做产品")
+            val quests = QuestRepository(db)
+            val expedition = ExpeditionRepository(db)
+            val quest = quests.createQuest(NewQuest(goal.id, title = "记录一个用户问题", reason = "验证需求", steps = listOf("记录原话"), instruction = "记录原话", estimatedMinutes = 5, completionCriteria = listOf("留下一条记录"), expectedOutput = "一条用户反馈", sourceIntention = "验证需求", sourceAvailableMinutes = 5, sourceEnergy = 3, sourceResources = listOf("PHONE")))
+            quests.startQuest(quest.id)
+            quests.completeQuest(quest.id, NewQuestResult("用户认为步骤太多", 5, null, null), artifact = NewQuestArtifact("用户反馈", "TEXT", "用户认为步骤太多"))
+            assertEquals(1, expedition.get(goal.id).completedActions)
+            assertEquals(1, expedition.get(goal.id).supplies)
+            assertEquals("用户认为步骤太多", expedition.observeArtifacts(goal.id).first().single().value)
+            assertThrows(IllegalStateException::class.java) {
+                runBlocking { quests.completeQuest(quest.id, NewQuestResult("重复提交", 5, null, null)) }
+            }
+            assertEquals(1, expedition.get(goal.id).supplies)
+            val second = quests.createQuest(NewQuest(goal.id, title = "再记录一个用户问题", reason = "继续验证", steps = listOf("记录原话"), instruction = "记录原话", estimatedMinutes = 5, completionCriteria = listOf("留下一条记录"), expectedOutput = "一条用户反馈", sourceIntention = "继续验证", sourceAvailableMinutes = 5, sourceEnergy = 3, sourceResources = listOf("PHONE")))
+            quests.startQuest(second.id)
+            quests.completeQuest(second.id, NewQuestResult("第二条", 5, null, null), artifact = NewQuestArtifact("第二条", "TEXT", "第二条"))
+            expedition.build(goal.id, CampBuilding.CAMPFIRE)
+            assertEquals(1, expedition.get(goal.id).campfireLevel)
+            assertEquals(0, expedition.get(goal.id).supplies)
+        } finally { db.close() }
+    }
+}
