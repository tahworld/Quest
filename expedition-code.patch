+
+/** A small map of the current chapter. Every filled stop represents a saved action. */
+@Composable
+fun TrailArtwork(completedActions: Int, modifier: Modifier = Modifier, height: Int = 206) {
+    val sky = MaterialTheme.colorScheme.secondaryContainer
+    val near = MaterialTheme.colorScheme.primaryContainer
+    val far = MaterialTheme.colorScheme.primary.copy(alpha = .15f)
+    val route = MaterialTheme.colorScheme.primary
+    val waiting = MaterialTheme.colorScheme.outlineVariant
+    val sun = MaterialTheme.colorScheme.tertiary
+    val revealed = ExpeditionRules.exploredInChapter(completedActions)
+    Surface(modifier, shape = RoundedCornerShape(30.dp), color = sky) {
+        Canvas(Modifier.fillMaxWidth().height(height.dp).padding(14.dp)) {
+            val w = size.width
+            val h = size.height
+            drawCircle(sun.copy(alpha = .7f), w * .085f, Offset(w * .82f, h * .20f))
+            val distant = Path().apply {
+                moveTo(0f, h * .58f)
+                quadraticBezierTo(w * .22f, h * .25f, w * .49f, h * .56f)
+                quadraticBezierTo(w * .75f, h * .23f, w, h * .50f)
+                lineTo(w, h); lineTo(0f, h); close()
+            }
+            drawPath(distant, far)
+            val foreground = Path().apply {
+                moveTo(0f, h * .83f)
+                quadraticBezierTo(w * .20f, h * .67f, w * .43f, h * .79f)
+                quadraticBezierTo(w * .75f, h * .98f, w, h * .70f)
+                lineTo(w, h); lineTo(0f, h); close()
+            }
+            drawPath(foreground, near)
+            val stops = (0 until ExpeditionRules.NODES_PER_CHAPTER).map { index ->
+                val x = w * (.09f + (index % 5) * .205f)
+                val y = if (index < 5) h * (.43f + (index % 2) * .11f) else h * (.74f - (index % 2) * .10f)
+                Offset(if (index < 5) x else w - x, y)
+            }
+            stops.zipWithNext().forEachIndexed { index, (from, to) ->
+                drawLine(if (index < revealed) route else waiting, from, to, strokeWidth = 4.dp.toPx(), cap = StrokeCap.Round,
+                    pathEffect = if (index < revealed) null else PathEffect.dashPathEffect(floatArrayOf(8.dp.toPx(), 7.dp.toPx())))
+            }
+            stops.forEachIndexed { index, stop ->
+                drawCircle(sky, 11.dp.toPx(), stop)
+                drawCircle(if (index < revealed) route else waiting, 7.dp.toPx(), stop)
+                if (index == revealed) {
+                    drawCircle(sun, 11.dp.toPx(), stop, style = Stroke(3.dp.toPx()))
+                    drawCircle(sun, 4.dp.toPx(), stop)
+                }
+            }
+        }
+    }
+}
+
+/** Camp upgrades have three visible states and are drawn locally, without an image download. */
+@Composable
+fun CampArtwork(progress: ExpeditionEntity, modifier: Modifier = Modifier) {
+    val sky = MaterialTheme.colorScheme.primaryContainer
+    val ground = MaterialTheme.colorScheme.primary.copy(alpha = .2f)
+    val wood = MaterialTheme.colorScheme.primary
+    val flame = MaterialTheme.colorScheme.tertiary
+    val detail = MaterialTheme.colorScheme.onPrimaryContainer
+    Surface(modifier, shape = RoundedCornerShape(30.dp), color = sky) {
+        Canvas(Modifier.fillMaxWidth().height(178.dp).padding(14.dp)) {
+            val w = size.width
+            val h = size.height
+            val base = h * .80f
+            drawRoundRect(ground, Offset(0f, base), Size(w, h - base), cornerRadius = androidx.compose.ui.geometry.CornerRadius(18.dp.toPx()))
+            // Three quiet silhouettes make the empty camp feel like a place to return to.
+            val fireX = w * .18f
+            drawLine(wood, Offset(fireX - 15.dp.toPx(), base), Offset(fireX + 13.dp.toPx(), base - 5.dp.toPx()), 4.dp.toPx(), cap = StrokeCap.Round)
+            drawLine(wood, Offset(fireX + 15.dp.toPx(), base), Offset(fireX - 13.dp.toPx(), base - 5.dp.toPx()), 4.dp.toPx(), cap = StrokeCap.Round)
+            if (progress.campfireLevel > 0) {
+                drawCircle(flame.copy(alpha = .17f), (23 + progress.campfireLevel * 6).dp.toPx(), Offset(fireX, base - 21.dp.toPx()))
+                val fire = Path().apply {
+                    moveTo(fireX, base - (29 + progress.campfireLevel * 6).dp.toPx())
+                    quadraticBezierTo(fireX + 17.dp.toPx(), base - 9.dp.toPx(), fireX, base - 7.dp.toPx())
+                    quadraticBezierTo(fireX - 16.dp.toPx(), base - 15.dp.toPx(), fireX, base - (29 + progress.campfireLevel * 6).dp.toPx())
+                }
+                drawPath(fire, flame)
+            }
+            val cabinX = w * .53f
+            val top = base - (48 + progress.shelterLevel * 8).dp.toPx()
+            val cabinColor = if (progress.shelterLevel > 0) wood else wood.copy(alpha = .28f)
+            drawRoundRect(cabinColor, Offset(cabinX - 31.dp.toPx(), top + 20.dp.toPx()), Size(62.dp.toPx(), base - top - 20.dp.toPx()),
+                cornerRadius = androidx.compose.ui.geometry.CornerRadius(5.dp.toPx()))
+            val roof = Path().apply {
+                moveTo(cabinX - 39.dp.toPx(), top + 22.dp.toPx())
+                lineTo(cabinX, top)
+                lineTo(cabinX + 39.dp.toPx(), top + 22.dp.toPx())
+                close()
+            }
+            drawPath(roof, cabinColor)
+            if (progress.shelterLevel > 0) {
+                drawRoundRect(sky, Offset(cabinX - 7.dp.toPx(), base - 23.dp.toPx()), Size(14.dp.toPx(), 23.dp.toPx()),
+                    cornerRadius = androidx.compose.ui.geometry.CornerRadius(6.dp.toPx()))
+                if (progress.shelterLevel > 1) drawCircle(flame, 4.dp.toPx(), Offset(cabinX + 19.dp.toPx(), top + 34.dp.toPx()))
+            }
+            val towerX = w * .84f
+            val towerTop = base - (53 + progress.lookoutLevel * 12).dp.toPx()
+            val towerColor = if (progress.lookoutLevel > 0) detail else detail.copy(alpha = .23f)
+            drawLine(towerColor, Offset(towerX - 12.dp.toPx(), base), Offset(towerX - 9.dp.toPx(), towerTop), 4.dp.toPx())
+            drawLine(towerColor, Offset(towerX + 12.dp.toPx(), base), Offset(towerX + 9.dp.toPx(), towerTop), 4.dp.toPx())
+            drawLine(towerColor, Offset(towerX - 20.dp.toPx(), towerTop), Offset(towerX + 20.dp.toPx(), towerTop), 5.dp.toPx(), cap = StrokeCap.Round)
+            if (progress.lookoutLevel > 0) drawCircle(flame, 5.dp.toPx(), Offset(towerX, towerTop - 10.dp.toPx()))
+        }
+    }
+}
