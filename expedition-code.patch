+package com.vika.quest.ai
+
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.*
+import org.junit.Test
+
+class AiContinueValidatorTest {
+    private val validator = AiContinueValidator(AiQuestDraftValidator())
+    private val parent = QuestReviewContext(
+        QuestSnapshot("q", "g", null, "记录今天跑步的实际结果", "COMPLETED", "已记录"),
+        "承接当前方向", listOf("记录结果"), listOf("留下一条记录"), "一条记录", "今晚完成跑量", 15, 3,
+        setOf(QuestResource.PHONE), GoalSnapshot("g", "跑步", "恢复跑步", 1), null,
+        emptyList(), emptyList(), "", emptyList(),
+    )
+    private fun context(count: Int = 0, result: String = "晚上必须跑步") = QuestContinueContext(parent, result, null, emptyList(), count, emptyList())
+
+    @Test fun refusesFourthQuestion() {
+        assertFailure { validator.validate(AiFollowUp.Question(SituationType.AMBIGUOUS, "未来30天最想改变什么？", "clarify_goal"), context(3)) }
+    }
+
+    @Test fun refusesMultipleQuestionsAndVagueAction() {
+        assertFailure { validator.validate(AiFollowUp.Question(SituationType.MIXED, "你要跑吗？你几点跑？", "choose_priority"), context()) }
+        val draft = AiQuestDraft("改善自己", "承接结果", 10, listOf("思考人生"), listOf("完成"), "记录", "g", null)
+        assertFailure { validator.validate(AiFollowUp.NextAction(SituationType.ACTIONABLE, draft), context()) }
+    }
+
+    @Test fun fakeProducesActionOrSingleQuestionAndAdvice() = runBlocking {
+        val fake = FakeAiProvider()
+        val actionable = context()
+        assertTrue(validator.validate(fake.generateFollowUp(actionable), actionable) is AiFollowUp.NextAction)
+        val ambiguous = context(result = "感觉生活没有起色")
+        assertTrue(validator.validate(fake.generateFollowUp(ambiguous), ambiguous) is AiFollowUp.Question)
+        val after = ambiguous.copy(questionCount = 3)
+        assertTrue(validator.validate(fake.generateFollowUp(after), after) is AiFollowUp.NextAction)
+        assertNotNull(validator.validateAdvice(fake.generateAdvice(after)))
+    }
+
+    private fun assertFailure(block: () -> Unit) {
+        try { block(); fail("应拒绝无效内容") } catch (_: IllegalArgumentException) { }
+    }
+}
