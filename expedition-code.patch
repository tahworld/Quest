@@ -0,0 +1,35 @@
+package com.vika.quest.model
+
+import com.vika.quest.data.local.entity.ExpeditionEntity
+
+enum class CampBuilding(val label: String) {
+    CAMPFIRE("篝火"), SHELTER("小屋"), LOOKOUT("瞭望台")
+}
+
+object ExpeditionRules {
+    const val NODES_PER_CHAPTER = 10
+    const val MAX_BUILDING_LEVEL = 3
+
+    fun chapter(completedActions: Int): Int = completedActions / NODES_PER_CHAPTER + 1
+    fun exploredInChapter(completedActions: Int): Int = completedActions % NODES_PER_CHAPTER
+    fun cost(nextLevel: Int): Int = nextLevel + 1
+
+    fun level(state: ExpeditionEntity, building: CampBuilding): Int = when (building) {
+        CampBuilding.CAMPFIRE -> state.campfireLevel
+        CampBuilding.SHELTER -> state.shelterLevel
+        CampBuilding.LOOKOUT -> state.lookoutLevel
+    }
+
+    fun build(state: ExpeditionEntity, building: CampBuilding): ExpeditionEntity {
+        val current = level(state, building)
+        require(current < MAX_BUILDING_LEVEL) { "这座建筑已经建成" }
+        val price = cost(current + 1)
+        require(state.supplies >= price) { "物资不足，完成行动可获得物资" }
+        val spent = state.copy(supplies = state.supplies - price)
+        return when (building) {
+            CampBuilding.CAMPFIRE -> spent.copy(campfireLevel = current + 1)
+            CampBuilding.SHELTER -> spent.copy(shelterLevel = current + 1)
+            CampBuilding.LOOKOUT -> spent.copy(lookoutLevel = current + 1)
+        }
+    }
+}
