@@ -0,0 +1,67 @@
+package com.vika.quest.ui.quest
+
+import androidx.compose.foundation.layout.*
+import androidx.compose.material3.*
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import androidx.compose.runtime.getValue
+
+@Composable
+fun ContinuePanel(vm: ContinueViewModel, onChild: (String) -> Unit, onLeave: () -> Unit) {
+    val state by vm.state.collectAsStateWithLifecycle()
+    val working = state.phase in setOf(ContinuePhase.THINKING, ContinuePhase.SUBMITTING_ANSWER, ContinuePhase.GENERATING_NEXT_QUEST)
+    Spacer(Modifier.height(32.dp))
+    HorizontalDivider()
+    Spacer(Modifier.height(24.dp))
+    Text("接下来呢？", style = MaterialTheme.typography.headlineSmall)
+    Spacer(Modifier.height(18.dp))
+    if (state.phase == ContinuePhase.PAUSED) {
+        Text("好，先放在这里。", style = MaterialTheme.typography.bodyLarge)
+        Spacer(Modifier.height(12.dp))
+        TextButton(onClick = vm::continueQuest) { Text("以后再继续") }
+        return
+    }
+    state.childId?.let { child ->
+        Button(onClick = { onChild(child) }, modifier = Modifier.fillMaxWidth().height(56.dp)) { Text("查看新的一步  →") }
+        return
+    }
+    state.question?.let { question ->
+        Text("Quest 想再问你一件事 · ${state.questionCount} / 3", color = MaterialTheme.colorScheme.primary, style = MaterialTheme.typography.labelLarge)
+        Spacer(Modifier.height(12.dp))
+        Text(question, style = MaterialTheme.typography.titleLarge)
+        Spacer(Modifier.height(12.dp))
+        OutlinedTextField(value = state.answer, onValueChange = vm::setAnswer, label = { Text("你的回答") }, minLines = 2, maxLines = 5, enabled = !working, modifier = Modifier.fillMaxWidth())
+        Spacer(Modifier.height(12.dp))
+        Button(onClick = vm::submitAnswer, enabled = !working && state.answer.isNotBlank(), modifier = Modifier.fillMaxWidth()) { Text("继续") }
+    }
+    state.advice?.let { advice ->
+        Spacer(Modifier.height(18.dp))
+        Surface(color = MaterialTheme.colorScheme.primaryContainer, shape = MaterialTheme.shapes.large) {
+            Column(Modifier.fillMaxWidth().padding(18.dp)) {
+                Text("我看到的核心", style = MaterialTheme.typography.titleMedium)
+                Text(advice.core)
+                Spacer(Modifier.height(14.dp))
+                Text("现在能做的", style = MaterialTheme.typography.titleMedium)
+                Text(advice.action)
+                Spacer(Modifier.height(14.dp))
+                Text("之后再处理", style = MaterialTheme.typography.titleMedium)
+                Text(advice.later)
+            }
+        }
+        Spacer(Modifier.height(12.dp))
+        OutlinedButton(onClick = vm::adviceToQuest, enabled = !working, modifier = Modifier.fillMaxWidth()) { Text("把它变成下一步") }
+    }
+    if (state.question == null && state.advice == null && !working && state.phase != ContinuePhase.ERROR) {
+        Button(onClick = vm::continueQuest, modifier = Modifier.fillMaxWidth().height(56.dp)) { Text("继续推进") }
+        OutlinedButton(onClick = vm::askAdvice, modifier = Modifier.fillMaxWidth()) { Text("给我一点建议") }
+    }
+    if (working) { Spacer(Modifier.height(12.dp)); LinearProgressIndicator(Modifier.fillMaxWidth()); Text("正在整理下一步…", style = MaterialTheme.typography.bodySmall) }
+    state.error?.let {
+        Spacer(Modifier.height(12.dp)); Text(it, color = MaterialTheme.colorScheme.error)
+        TextButton(onClick = vm::retry, enabled = !working) { Text("重试") }
+    }
+    Spacer(Modifier.height(8.dp))
+    TextButton(onClick = { vm.pause(); onLeave() }, modifier = Modifier.fillMaxWidth()) { Text("先放在这里") }
+}
diff --git a/app/src/main/java/com/vika/quest/ui/quest/ContinueViewModel.kt b/app/src/main/java/com/vika/quest/ui/quest/ContinueViewModel.kt
new file mode 100644
index 0000000..57678ae
--- /dev/null
+++ b/app/src/main/java/com/vika/quest/ui/quest/ContinueViewModel.kt
@@ -0,0 +1,176 @@
+package com.vika.quest.ui.quest
+
+import androidx.lifecycle.SavedStateHandle
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.vika.quest.ai.*
+import com.vika.quest.data.local.entity.AdviceResultEntity
+import com.vika.quest.data.local.entity.ContinueTurnEntity
+import com.vika.quest.data.repository.ContinueRepository
+import com.vika.quest.data.repository.QuestRepository
+import com.vika.quest.model.QuestStatus
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+
+enum class ContinuePhase { IDLE, THINKING, ASKING, SUBMITTING_ANSWER, GENERATING_NEXT_QUEST, NEXT_QUEST_READY, ERROR, PAUSED }
+private enum class RetryOperation { FOLLOW_UP, ADVICE, ADVICE_TO_QUEST }
+
+data class ContinueUiState(
+    val phase: ContinuePhase = ContinuePhase.IDLE,
+    val question: String? = null,
+    val answer: String = "",
+    val questionCount: Int = 0,
+    val advice: AdviceResultEntity? = null,
+    val childId: String? = null,
+    val error: String? = null,
+)
+
+class ContinueViewModel(
+    private val questId: String,
+    private val quests: QuestRepository,
+    private val repository: ContinueRepository,
+    private val contexts: ContextBuilder,
+    private val ai: AiProvider,
+    private val validator: AiContinueValidator,
+    private val saved: SavedStateHandle,
+) : ViewModel() {
+    private val _state = MutableStateFlow(ContinueUiState(answer = saved[ANSWER] ?: ""))
+    val state = _state.asStateFlow()
+    private var busy = false
+    private var job: Job? = null
+    private var retry: RetryOperation? = null
+
+    init { viewModelScope.launch { restore() } }
+
+    fun setAnswer(value: String) { saved[ANSWER] = value; _state.update { it.copy(answer = value, error = null) } }
+
+    fun continueQuest() {
+        if (busy) return
+        launch(ContinuePhase.THINKING, RetryOperation.FOLLOW_UP) {
+            val session = repository.begin(questId)
+            val turns = repository.turns(session.id)
+            if (turns.lastOrNull()?.answer == null && turns.isNotEmpty()) { restore(); return@launch }
+            requestFollowUp()
+        }
+    }
+
+    fun submitAnswer() {
+        if (busy) return
+        val answer = _state.value.answer.trim()
+        if (answer.isEmpty()) { _state.update { it.copy(error = "请写下你的回答") }; return }
+        launch(ContinuePhase.SUBMITTING_ANSWER, RetryOperation.FOLLOW_UP) {
+            repository.answer(questId, answer)
+            requestFollowUp()
+            saved[ANSWER] = ""
+            _state.update { it.copy(answer = "") }
+        }
+    }
+
+    fun askAdvice() {
+        if (busy) return
+        launch(ContinuePhase.THINKING, RetryOperation.ADVICE) {
+            repository.advice(questId)?.let { restore(); return@launch }
+            val quest = checkNotNull(quests.getQuest(questId))
+            val session = repository.session(questId)
+            val context = contexts.buildContinue(quest, exchanges(session?.id), session?.questionCount ?: 0)
+            val value = validator.validateAdvice(ai.generateAdvice(context))
+            repository.saveAdvice(questId, value.core, value.action, value.later)
+            restore()
+        }
+    }
+
+    fun adviceToQuest() {
+        if (busy) return
+        launch(ContinuePhase.GENERATING_NEXT_QUEST, RetryOperation.ADVICE_TO_QUEST) {
+            repository.child(questId)?.let { restore(); return@launch }
+            val advice = checkNotNull(repository.advice(questId))
+            repository.begin(questId)
+            val quest = checkNotNull(quests.getQuest(questId))
+            val session = checkNotNull(repository.session(questId))
+            val context = contexts.buildContinue(quest, exchanges(session.id), session.questionCount, AiAdvice(advice.core, advice.action, advice.later))
+            createChild(context)
+        }
+    }
+
+    fun pause() {
+        job?.cancel()
+        busy = false
+        retry = null
+        _state.update { it.copy(phase = ContinuePhase.PAUSED, error = null) }
+        viewModelScope.launch { repository.pause(questId); restore() }
+    }
+
+    fun retry() {
+        if (busy) return
+        when (retry) {
+            RetryOperation.FOLLOW_UP -> continueQuest()
+            RetryOperation.ADVICE -> askAdvice()
+            RetryOperation.ADVICE_TO_QUEST -> adviceToQuest()
+            null -> Unit
+        }
+    }
+
+    private suspend fun requestFollowUp() {
+        repository.child(questId)?.let { restore(); return }
+        val quest = checkNotNull(quests.getQuest(questId))
+        check(quest.status == QuestStatus.COMPLETED)
+        val session = checkNotNull(repository.session(questId))
+        if (session.status == "PAUSED") { restore(); return }
+        val context = contexts.buildContinue(quest, exchanges(session.id), session.questionCount)
+        when (val reply = validator.validate(ai.generateFollowUp(context), context)) {
+            is AiFollowUp.Question -> {
+                repository.saveQuestion(questId, reply.question, reply.reasoningType)
+                restore()
+            }
+            is AiFollowUp.NextAction -> createChild(context, reply)
+        }
+    }
+
+    private suspend fun createChild(context: QuestContinueContext, existing: AiFollowUp.NextAction? = null) {
+        val reply = existing ?: validator.validate(ai.generateFollowUp(context), context) as? AiFollowUp.NextAction
+            ?: error("AI 未能把建议转成具体行动，请重试")
+        val draft = validator.generationContext(context)
+        val next = AiQuestDraftValidator().validate(reply.draft, draft)
+        repository.saveChild(questId, next)
+        restore()
+    }
+
+    private suspend fun exchanges(sessionId: String?): List<ContinueExchange> =
+        sessionId?.let { repository.turns(it) }.orEmpty().filter { it.answer != null }
+            .takeLast(ContinueRepository.MAX_QUESTIONS).map { ContinueExchange(it.question.orEmpty(), it.answer.orEmpty()) }
+
+    private suspend fun restore() {
+        val session = repository.session(questId)
+        val turns = session?.let { repository.turns(it.id) }.orEmpty()
+        val advice = repository.advice(questId)
+        val child = repository.child(questId)
+        _state.update { old -> old.copy(
+            phase = when {
+                child != null -> ContinuePhase.NEXT_QUEST_READY
+                session?.status == "PAUSED" -> ContinuePhase.PAUSED
+                turns.lastOrNull()?.answer == null && turns.isNotEmpty() -> ContinuePhase.ASKING
+                else -> ContinuePhase.IDLE
+            }, question = turns.lastOrNull()?.takeIf { it.answer == null }?.question,
+            questionCount = session?.questionCount ?: 0, advice = advice, childId = child?.id, error = null,
+        ) }
+    }
+
+    private fun launch(phase: ContinuePhase, operation: RetryOperation, block: suspend () -> Unit) {
+        if (busy) return
+        busy = true
+        retry = operation
+        _state.update { it.copy(phase = phase, error = null) }
+        job = viewModelScope.launch {
+            try { block(); retry = null }
+            catch (error: CancellationException) { throw error }
+            catch (error: Exception) { _state.update { it.copy(phase = ContinuePhase.ERROR, error = "这次没有生成成功：${error.message ?: "请重试"}") } }
+            finally { busy = false }
+        }
+    }
+
+    companion object { private const val ANSWER = "continue_answer" }
+}
