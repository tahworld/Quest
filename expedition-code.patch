+package com.vika.quest.ui.expedition
+
+import android.content.Intent
+import android.net.Uri
+import androidx.compose.foundation.Canvas
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.graphics.Path
+import androidx.compose.ui.graphics.PathEffect
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.vika.quest.data.local.entity.ExpeditionEntity
+import com.vika.quest.data.repository.ArtifactStorage
+import com.vika.quest.model.CampBuilding
+import com.vika.quest.model.ExpeditionRules
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun ExpeditionScreen(vm: ExpeditionViewModel, storage: ArtifactStorage, onBack: () -> Unit) {
+    val state by vm.state.collectAsStateWithLifecycle()
+    val context = LocalContext.current
+    var openError by remember { mutableStateOf<String?>(null) }
+    Scaffold(
+        contentWindowInsets = WindowInsets.safeDrawing,
+        topBar = { TopAppBar(title = { Text("我的旅程") }, navigationIcon = { TextButton(onClick = onBack) { Text("返回") } }) },
+    ) { padding ->
+        Column(Modifier.fillMaxSize().padding(padding).verticalScroll(rememberScrollState()).padding(horizontal = 24.dp, vertical = 16.dp)) {
+            if (state.loading) { CircularProgressIndicator(); return@Column }
+            val progress = state.expedition ?: return@Column
+            Text(state.goalName, style = MaterialTheme.typography.headlineSmall)
+            Spacer(Modifier.height(8.dp))
+            Text("第 ${ExpeditionRules.chapter(progress.completedActions)} 章 · 累计走出 ${progress.completedActions} 步", color = MaterialTheme.colorScheme.onSurfaceVariant)
+            Spacer(Modifier.height(16.dp))
+            ExpeditionMap(progress.completedActions)
+            Spacer(Modifier.height(12.dp))
+            Text("下一格由下一次真实行动开启。离开一段时间后，已经走过的路仍在这里。", style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+            Spacer(Modifier.height(28.dp))
+            Text("我的营地", style = MaterialTheme.typography.titleLarge)
+            Text("物资 ${progress.supplies} · 完成一个行动获得 1 份", color = MaterialTheme.colorScheme.onSurfaceVariant)
+            Spacer(Modifier.height(12.dp))
+            CampScene(progress)
+            CampBuilding.entries.forEach { building ->
+                val level = ExpeditionRules.level(progress, building)
+                val price = ExpeditionRules.cost(level + 1)
+                Row(Modifier.fillMaxWidth().padding(top = 10.dp), horizontalArrangement = Arrangement.SpaceBetween) {
+                    Column { Text(building.label, style = MaterialTheme.typography.titleMedium); Text("$level / ${ExpeditionRules.MAX_BUILDING_LEVEL} 级", style = MaterialTheme.typography.bodySmall) }
+                    OutlinedButton(onClick = { vm.build(building) }, enabled = !state.building && level < ExpeditionRules.MAX_BUILDING_LEVEL && progress.supplies >= price) {
+                        Text(if (level == ExpeditionRules.MAX_BUILDING_LEVEL) "已建成" else "建设 · $price 物资")
+                    }
+                }
+            }
+            state.error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+            Spacer(Modifier.height(30.dp))
+            Text("成果陈列", style = MaterialTheme.typography.titleLarge)
+            Spacer(Modifier.height(8.dp))
+            if (state.artifacts.isEmpty()) Text("走出第一步后，成果会留在这里。", color = MaterialTheme.colorScheme.onSurfaceVariant)
+            state.artifacts.forEach { artifact ->
+                HorizontalDivider(Modifier.padding(vertical = 12.dp))
+                Text(artifact.title, style = MaterialTheme.typography.titleMedium)
+                when (artifact.kind) {
+                    "TEXT" -> Text(artifact.value, style = MaterialTheme.typography.bodyMedium)
+                    "LINK", "FILE" -> TextButton(onClick = {
+                        try {
+                            val uri = if (artifact.kind == "FILE") storage.openUri(artifact.value) else Uri.parse(artifact.value)
+                            val intent = Intent(Intent.ACTION_VIEW, uri).addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                            context.startActivity(intent)
+                            openError = null
+                        } catch (error: Exception) { openError = "无法打开成果，请确认文件或链接仍可用。" }
+                    }) { Text(if (artifact.kind == "FILE") "打开保存的文件" else "打开成果链接") }
+                }
+            }
+            openError?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+            Spacer(Modifier.height(24.dp))
+        }
+    }
+}
+
+@Composable
+private fun ExpeditionMap(completedActions: Int) {
+    val revealed = ExpeditionRules.exploredInChapter(completedActions)
+    val active = MaterialTheme.colorScheme.primary
+    val unexplored = MaterialTheme.colorScheme.outlineVariant
+    val highlight = MaterialTheme.colorScheme.tertiary
+    Surface(color = MaterialTheme.colorScheme.primaryContainer, shape = MaterialTheme.shapes.large) {
+        Canvas(Modifier.fillMaxWidth().height(220.dp).padding(18.dp)) {
+            val nodes = (0..9).map { index ->
+                val column = if (index < 5) index else 9 - index
+                Offset(size.width * (0.08f + column * 0.21f), size.height * if (index < 5) 0.28f else 0.72f)
+            }
+            nodes.zipWithNext().forEachIndexed { index, (from, to) ->
+                drawLine(if (index < revealed) active else unexplored, from, to, strokeWidth = 6.dp.toPx(), pathEffect = if (index < revealed) null else PathEffect.dashPathEffect(floatArrayOf(10f, 8f)))
+            }
+            nodes.forEachIndexed { index, point ->
+                drawCircle(if (index < revealed) active else unexplored, radius = 12.dp.toPx(), center = point)
+                if (index == revealed) drawCircle(highlight, radius = 7.dp.toPx(), center = point)
+            }
+        }
+    }
+}
+
+@Composable
+private fun CampScene(progress: ExpeditionEntity) {
+    val line = MaterialTheme.colorScheme.primary
+    val ground = MaterialTheme.colorScheme.secondary
+    val glow = MaterialTheme.colorScheme.tertiary
+    Surface(color = MaterialTheme.colorScheme.secondaryContainer, shape = MaterialTheme.shapes.large) {
+        Canvas(Modifier.fillMaxWidth().height(140.dp).padding(18.dp)) {
+            val y = size.height * 0.77f
+            drawLine(ground, Offset(0f, y), Offset(size.width, y), strokeWidth = 4.dp.toPx())
+            if (progress.campfireLevel > 0) {
+                val x = size.width * 0.2f
+                drawCircle(glow.copy(alpha = .23f), radius = (19 + progress.campfireLevel * 5).dp.toPx(), center = Offset(x, y - 17.dp.toPx()))
+                drawCircle(glow, radius = (8 + progress.campfireLevel * 2).dp.toPx(), center = Offset(x, y - 12.dp.toPx()))
+            }
+            if (progress.shelterLevel > 0) {
+                val x = size.width * 0.53f
+                val top = y - (33 + progress.shelterLevel * 7).dp.toPx()
+                drawRect(line.copy(alpha = .45f), Offset(x - 28.dp.toPx(), top + 18.dp.toPx()), androidx.compose.ui.geometry.Size(56.dp.toPx(), y - top - 18.dp.toPx()))
+                val roof = Path().apply { moveTo(x - 35.dp.toPx(), top + 20.dp.toPx()); lineTo(x, top); lineTo(x + 35.dp.toPx(), top + 20.dp.toPx()); close() }
+                drawPath(roof, line)
+            }
+            if (progress.lookoutLevel > 0) {
+                val x = size.width * 0.83f
+                val top = y - (39 + progress.lookoutLevel * 10).dp.toPx()
+                drawLine(line, Offset(x - 12.dp.toPx(), y), Offset(x - 12.dp.toPx(), top), 4.dp.toPx())
+                drawLine(line, Offset(x + 12.dp.toPx(), y), Offset(x + 12.dp.toPx(), top), 4.dp.toPx())
+                drawLine(line, Offset(x - 22.dp.toPx(), top), Offset(x + 22.dp.toPx(), top), 5.dp.toPx())
+                drawCircle(glow, 5.dp.toPx(), Offset(x, top - 9.dp.toPx()))
+            }
+        }
+    }
+}
