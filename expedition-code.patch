@@ -0,0 +1,93 @@
+package com.vika.quest.ui.quest
+
+import androidx.lifecycle.SavedStateHandle
+import androidx.room.Room
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.vika.quest.ai.*
+import com.vika.quest.data.local.QuestDatabase
+import com.vika.quest.data.repository.*
+import com.vika.quest.model.NewQuest
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@RunWith(AndroidJUnit4::class)
+class ContinueViewModelTest {
+    @Test fun rapidTapsProduceOneRequestAndOneChild() = runBlocking {
+        val db = Room.inMemoryDatabaseBuilder(InstrumentationRegistry.getInstrumentation().targetContext, QuestDatabase::class.java).build()
+        try {
+            val quests = QuestRepository(db)
+            val parent = completed(quests)
+            val repository = ContinueRepository(db, quests)
+            val provider = CountingProvider()
+            val vm = create(parent.id, db, quests, repository, provider)
+            vm.continueQuest()
+            vm.continueQuest()
+            withTimeout(5_000) { vm.state.first { it.phase == ContinuePhase.NEXT_QUEST_READY } }
+            assertEquals(1, provider.calls)
+            assertNotNull(repository.child(parent.id))
+            assertEquals(parent.id, repository.child(parent.id)?.parentQuestId)
+        } finally { db.close() }
+    }
+
+    @Test fun pauseCancelsRequestAndPersistsWithoutChild() = runBlocking {
+        val db = Room.inMemoryDatabaseBuilder(InstrumentationRegistry.getInstrumentation().targetContext, QuestDatabase::class.java).build()
+        try {
+            val quests = QuestRepository(db)
+            val parent = completed(quests)
+            val repository = ContinueRepository(db, quests)
+            val provider = CountingProvider(1_000)
+            val vm = create(parent.id, db, quests, repository, provider)
+            vm.continueQuest()
+            withTimeout(5_000) { while (provider.calls == 0) delay(10) }
+            vm.pause()
+            withTimeout(5_000) { while (repository.session(parent.id)?.status != "PAUSED") delay(10) }
+            assertEquals("PAUSED", repository.session(parent.id)?.status)
+            assertNull(repository.child(parent.id))
+        } finally { db.close() }
+    }
+
+    @Test fun recreatedViewModelRestoresPersistedQuestionAndAnswerDraft() = runBlocking {
+        val db = Room.inMemoryDatabaseBuilder(InstrumentationRegistry.getInstrumentation().targetContext, QuestDatabase::class.java).build()
+        try {
+            val quests = QuestRepository(db)
+            val parent = completed(quests)
+            val repository = ContinueRepository(db, quests)
+            val session = repository.begin(parent.id)
+            repository.saveQuestion(parent.id, "眼前最需要确认的具体障碍是什么？", "identify_blocker")
+            val handle = SavedStateHandle(mapOf("continue_answer" to "今晚八点才有空"))
+            val vm = ContinueViewModel(parent.id, quests, repository,
+                ContextBuilder(GoalRepository(db.goalDao()), ProjectRepository(db.projectDao()), MemoryRepository(db.memoryDao()), quests, UserPreferenceRepository(db.userPreferenceDao())),
+                FakeAiProvider(), AiContinueValidator(AiQuestDraftValidator()), handle)
+            val restored = withTimeout(5_000) { vm.state.first { it.phase == ContinuePhase.ASKING } }
+            assertEquals("眼前最需要确认的具体障碍是什么？", restored.question)
+            assertEquals("今晚八点才有空", restored.answer)
+            assertEquals(1, repository.turns(session.id).size)
+        } finally { db.close() }
+    }
+
+    private fun create(id: String, db: QuestDatabase, quests: QuestRepository, repository: ContinueRepository, provider: AiProvider): ContinueViewModel {
+        val context = ContextBuilder(GoalRepository(db.goalDao()), ProjectRepository(db.projectDao()), MemoryRepository(db.memoryDao()), quests, UserPreferenceRepository(db.userPreferenceDao()))
+        return ContinueViewModel(id, quests, repository, context, provider, AiContinueValidator(AiQuestDraftValidator()), SavedStateHandle())
+    }
+
+    private suspend fun completed(quests: QuestRepository) = quests.createQuest(NewQuest(
+        goalId = null, title = "记录一次眼前的具体障碍", reason = "先得到进展", steps = listOf("记录具体障碍"), instruction = "记录具体障碍",
+        estimatedMinutes = 5, completionCriteria = listOf("留下记录"), expectedOutput = "一条记录",
+        sourceIntention = "今晚完成跑步", sourceAvailableMinutes = 15, sourceEnergy = 3, sourceResources = listOf("PHONE"),
+    )).also { quests.startQuest(it.id); quests.completeQuest(it.id, NewQuestResult("今晚八点以后还需要跑步", 5, null, null)) }
+
+    private class CountingProvider(private val latency: Long = 100) : AiProvider by FakeAiProvider() {
+        var calls = 0
+        override suspend fun generateFollowUp(context: QuestContinueContext): AiFollowUp {
+            calls++
+            delay(latency)
+            return FakeAiProvider().generateFollowUp(context)
+        }
+    }
+}
