+    fun parseFollowUp(raw: String): AiFollowUp {
+        val json = JSONObject(extractJson(raw))
+        val situation = when (json.requiredString("situationType").lowercase()) {
+            "actionable" -> SituationType.ACTIONABLE
+            "ambiguous" -> SituationType.AMBIGUOUS
+            "mixed" -> SituationType.MIXED
+            else -> throw IllegalArgumentException("未知情况类型")
+        }
+        return when (json.requiredString("type").lowercase()) {
+            "question" -> {
+                require(!json.has("steps") && !json.has("title") && !json.has("questions")) { "不能同时给出行动或多个问题" }
+                AiFollowUp.Question(situation, json.requiredString("question"), json.requiredString("reasoningType"))
+            }
+            "next_action" -> {
+                require(!json.has("question") && !json.has("questions")) { "不能同时提出问题" }
+                AiFollowUp.NextAction(situation, parseQuest(json.toString()))
+            }
+            else -> throw IllegalArgumentException("未知推进类型")
+        }
+    }
+
+    fun parseAdvice(raw: String): AiAdvice {
+        val json = JSONObject(extractJson(raw))
+        return AiAdvice(json.requiredString("core"), json.requiredString("action"), json.requiredString("later"))
+    }
