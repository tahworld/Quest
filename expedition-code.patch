@@ -0,0 +1,67 @@
+package com.vika.quest.data.repository
+
+import android.content.Context
+import android.net.Uri
+import android.provider.OpenableColumns
+import androidx.core.content.FileProvider
+import java.io.File
+import java.util.UUID
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+data class StoredArtifact(val name: String, val path: String)
+
+class ArtifactStorage(private val context: Context) {
+    fun rememberReadAccess(uri: Uri) {
+        context.contentResolver.takePersistableUriPermission(uri, android.content.Intent.FLAG_GRANT_READ_URI_PERMISSION)
+    }
+
+    fun displayName(uri: Uri): String {
+        context.contentResolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use {
+            if (it.moveToFirst()) return it.getString(0)?.take(100)?.ifBlank { "成果文件" } ?: "成果文件"
+        }
+        return "成果文件"
+    }
+
+    suspend fun saveCopy(uri: Uri): StoredArtifact = withContext(Dispatchers.IO) {
+        val name = displayName(uri)
+        val safeName = name.replace(Regex("[^\\p{L}\\p{N}._-]"), "_").takeLast(80)
+        val folder = File(context.filesDir, "artifacts").apply { mkdirs() }
+        val file = File(folder, "${UUID.randomUUID()}_$safeName")
+        try {
+            val input = context.contentResolver.openInputStream(uri) ?: error("无法读取所选文件")
+            input.use { source ->
+                file.outputStream().use { target ->
+                    val bytes = ByteArray(8192)
+                    var total = 0L
+                    while (true) {
+                        val count = source.read(bytes)
+                        if (count < 0) break
+                        total += count
+                        require(total <= MAX_FILE_BYTES) { "成果文件不能超过 15 MB" }
+                        target.write(bytes, 0, count)
+                    }
+                }
+            }
+            StoredArtifact(name, file.absolutePath)
+        } catch (error: Exception) {
+            file.delete()
+            throw error
+        }
+    }
+
+    fun openUri(path: String): Uri {
+        val folder = File(context.filesDir, "artifacts").canonicalFile
+        val file = File(path).canonicalFile
+        require(file.parentFile == folder && file.isFile) { "成果文件已经无法打开" }
+        return FileProvider.getUriForFile(context, "${context.packageName}.artifacts", file)
+    }
+
+    fun deleteImported(path: String) {
+        val folder = File(context.filesDir, "artifacts").canonicalFile
+        val file = File(path).canonicalFile
+        if (file.parentFile == folder) file.delete()
+    }
+
+    companion object { private const val MAX_FILE_BYTES = 15L * 1024 * 1024 }
+}
