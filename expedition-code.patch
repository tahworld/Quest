+            Text("每完成一个行动，获得 1 份物资。", style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant, modifier = Modifier.padding(top = 10.dp))
+            CampBuilding.entries.forEach { building ->
+                val level = ExpeditionRules.level(progress, building)
