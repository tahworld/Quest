@@ -0,0 +1,68 @@
+package com.vika.quest.data.local
+
+import androidx.room.Room
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.vika.quest.data.repository.ContinueRepository
+import com.vika.quest.data.repository.NewQuestResult
+import com.vika.quest.data.repository.QuestRepository
+import com.vika.quest.model.NewQuest
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.flow.first
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@RunWith(AndroidJUnit4::class)
+class ContinueRepositoryTest {
+    @Test fun oneSessionThreeQuestionsPauseAndOnlyOneChild() = runBlocking {
+        val db = Room.inMemoryDatabaseBuilder(InstrumentationRegistry.getInstrumentation().targetContext, QuestDatabase::class.java).build()
+        try {
+            val quests = QuestRepository(db)
+            val continuation = ContinueRepository(db, quests)
+            val parent = quests.createQuest(newQuest())
+            quests.startQuest(parent.id)
+            quests.completeQuest(parent.id, NewQuestResult("今晚需要继续推进", 5, null, null))
+            val session = continuation.begin(parent.id)
+            assertEquals(session.id, continuation.begin(parent.id).id)
+            repeat(3) { index ->
+                continuation.saveQuestion(parent.id, "问题 ${index + 1}？", "clarify_goal")
+                // Double submission of the same question cannot create a second turn.
+                continuation.saveQuestion(parent.id, "重复问题？", "clarify_goal")
+                continuation.answer(parent.id, "回答 ${index + 1}")
+            }
+            assertEquals(3, continuation.turns(session.id).size)
+            assertEquals(3, continuation.session(parent.id)?.questionCount)
+            try { continuation.saveQuestion(parent.id, "第四问？", "clarify_goal"); fail("不应允许第四问") } catch (_: IllegalStateException) { }
+            val child = continuation.saveChild(parent.id, newQuest())
+            assertEquals(parent.id, child.parentQuestId)
+            assertEquals(child.id, continuation.saveChild(parent.id, newQuest()).id)
+            assertEquals(1, quests.observeQuests().first().count { it.parentQuestId == parent.id })
+            assertEquals("NEXT_QUEST_READY", continuation.session(parent.id)?.status)
+        } finally { db.close() }
+    }
+
+    @Test fun adviceSavedOnceAndPauseDoesNotCreateAction() = runBlocking {
+        val db = Room.inMemoryDatabaseBuilder(InstrumentationRegistry.getInstrumentation().targetContext, QuestDatabase::class.java).build()
+        try {
+            val quests = QuestRepository(db)
+            val continuation = ContinueRepository(db, quests)
+            val parent = quests.createQuest(newQuest())
+            quests.startQuest(parent.id)
+            quests.completeQuest(parent.id, NewQuestResult("发现一个问题", 5, null, null))
+            val advice = continuation.saveAdvice(parent.id, "核心", "动作", "之后")
+            assertEquals(advice.id, continuation.saveAdvice(parent.id, "另一份", "另一个", "另一个").id)
+            continuation.pause(parent.id)
+            assertEquals("PAUSED", continuation.session(parent.id)?.status)
+            assertNull(continuation.child(parent.id))
+            try { continuation.saveChild(parent.id, newQuest()); fail("暂停后不应创建行动") } catch (_: IllegalStateException) { }
+        } finally { db.close() }
+    }
+
+    private fun newQuest() = NewQuest(
+        goalId = null, title = "记录一次具体的五分钟行动", reason = "承接上一条结果", steps = listOf("执行一个小动作"),
+        instruction = "执行一个小动作", estimatedMinutes = 5, completionCriteria = listOf("留下一条执行记录"),
+        expectedOutput = "一条行动记录", sourceIntention = "继续推进", sourceAvailableMinutes = 15,
+        sourceEnergy = 3, sourceResources = listOf("PHONE"),
+    )
+}
