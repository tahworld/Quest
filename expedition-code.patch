+package com.vika.quest.ui.expedition
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.vika.quest.data.local.entity.ArtifactEntity
+import com.vika.quest.data.local.entity.ExpeditionEntity
+import com.vika.quest.data.repository.ExpeditionRepository
+import com.vika.quest.data.repository.GoalRepository
+import com.vika.quest.model.CampBuilding
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.collect
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+
+data class ExpeditionUiState(
+    val goalName: String = "",
+    val expedition: ExpeditionEntity? = null,
+    val artifacts: List<ArtifactEntity> = emptyList(),
+    val loading: Boolean = true,
+    val building: Boolean = false,
+    val error: String? = null,
+)
+
+class ExpeditionViewModel(
+    private val goalId: String,
+    goals: GoalRepository,
+    private val expeditions: ExpeditionRepository,
+) : ViewModel() {
+    private val _state = MutableStateFlow(ExpeditionUiState())
+    val state = _state.asStateFlow()
+
+    init {
+        viewModelScope.launch {
+            combine(goals.observeGoals(), expeditions.observe(goalId), expeditions.observeArtifacts(goalId)) { allGoals, progress, artifacts ->
+                Triple(allGoals.firstOrNull { it.id == goalId }?.name.orEmpty(), progress ?: ExpeditionEntity(goalId), artifacts)
+            }.collect { (name, progress, artifacts) ->
+                _state.update { it.copy(goalName = name, expedition = progress, artifacts = artifacts, loading = false) }
+            }
+        }
+    }
+
+    fun build(building: CampBuilding) {
+        if (_state.value.building) return
+        _state.update { it.copy(building = true, error = null) }
+        viewModelScope.launch {
+            try {
+                expeditions.build(goalId, building)
+                _state.update { it.copy(building = false) }
+            } catch (error: CancellationException) { throw error }
+            catch (error: Exception) { _state.update { it.copy(building = false, error = error.message ?: "建造失败") } }
+        }
+    }
+}
