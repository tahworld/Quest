+    fun observe(goalId: String) = dao.observe(goalId)
+    fun observeArtifacts(goalId: String) = database.artifactDao().observeForGoal(goalId)
+    suspend fun get(goalId: String): ExpeditionEntity = dao.get(goalId) ?: ExpeditionEntity(goalId)
+    suspend fun getArtifact(questId: String) = database.artifactDao().getForQuest(questId)
+
+    suspend fun build(goalId: String, building: CampBuilding) = database.withTransaction {
+        val existing = dao.get(goalId) ?: ExpeditionEntity(goalId)
+        val updated = ExpeditionRules.build(existing, building)
+        dao.upsert(updated)
+        updated
+    }
+}
